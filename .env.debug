# 本地调试环境变量（配合 docker-compose.debug.yml 使用）
# 用法：source .env.debug 然后 python -m api.main

# ── Anthropic / DeepSeek ──
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_MODEL=deepseek-chat
ANTHROPIC_API_KEY=sk-8ec5e72baf8b4b6daeebf6e11ad85639

# ── Redis（Docker 中启动了带密码的 Redis，注意密码）──
REDIS_URL=redis://:maxmind123@localhost:6379/0

# ── ChromaDB（Docker 映射到本地 8001 端口）──
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIRECTORY=./data/chroma

# ── 其他 ──
APP_ENV=development
LOG_LEVEL=DEBUG
EVAL_BASELINE_PATH=./data/eval/baseline.json
MAXMIND_SKILLS_DIR=./skills
